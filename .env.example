# Copy to .env and fill in. Never commit .env.

# --- LLM: anthropic | openai | fake (offline demo, no key) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# For OpenAI instead: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini, OPENAI_API_KEY=...

# --- Embeddings: openai | hash (offline keyword search, no key) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Retrieval ---
TOP_K=5
# OpenAI embeddings: ~0.30. Hash embeddings: ~0.20. Raise it if you get off-topic answers.
MIN_SIMILARITY=0.30

# --- Admin ---
ADMIN_API_KEY=change-me

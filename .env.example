# Copy to .env and fill in. Never commit .env.

# --- LLM: anthropic | openai | fake (offline demo, no key) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# For OpenAI instead: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini, OPENAI_API_KEY=...

# What the assistant is, used in its instructions
ASSISTANT_ROLE=an operations SOP assistant

# --- Embeddings: local (free, on your computer) | openai | hash (keyword-only, tests) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For OpenAI instead: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small, OPENAI_API_KEY=...
OPENAI_API_KEY=

# --- Retrieval ---
TOP_K=5
# Leave empty for the default (local 0.60, openai 0.30, hash 0.20).
# Raise it if you get off-topic answers; lower it if it refuses questions the documents do answer.
MIN_SIMILARITY=

# --- Admin ---
ADMIN_API_KEY=change-me
